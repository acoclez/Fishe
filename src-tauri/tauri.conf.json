{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fishe",
  "version": "0.16.0",
  "identifier": "com.fishe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Fishe",
        "width": 1240,
        "height": 860,
        "minWidth": 940,
        "minHeight": 640,
        "backgroundColor": "#0b0d0f",
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Real-time traffic gauge for a remote host or a local process",
    "category": "Utility"
  }
}
